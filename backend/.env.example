# Folder with YOUR documents (pdf, docx, txt, md). Windows example: C:/Users/you/Documents/docs
DOCS_ROOT=./sample_docs
# SQLite + ChromaDB live here (git-ignored)
DATA_DIR=./data
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
# sentence-transformers model name, or "hashing" for the offline lexical fallback
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Ollama (run `ollama serve`, then `ollama pull llama3.2:3b`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Chunking: ~tokens per chunk (4 chars/token estimate) and overlap as a percentage of the chunk
CHUNK_TOKENS=600
CHUNK_OVERLAP_PCT=12
# Retrieval: how many chunks go to the prompt / how many candidates are fetched first
TOP_K=5
FETCH_K=20
# Maximal Marginal Relevance: diversify results (lambda 1 = pure relevance, 0 = pure diversity)
USE_MMR=true
MMR_LAMBDA=0.6
# Cross-encoder reranking (needs sentence-transformers; slower, usually more precise)
USE_RERANKER=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunks with cosine similarity below this are ignored (tune per embedder!)
MIN_SIMILARITY=0.25
# Previous user/assistant turns sent to the model and used for query rewriting
MAX_HISTORY_TURNS=6
TEMPERATURE=0.1
# Model context window (prompt + answer must fit)
CONTEXT_TOKENS=4096
MAX_ANSWER_TOKENS=700
LLM_TIMEOUT_S=300
CORS_ORIGINS=http://localhost:5173
