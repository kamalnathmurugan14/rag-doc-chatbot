  "components": {
    "schemas": {
      "Body_upload_fs_upload_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_fs_upload_post"
      },
      "ChatIn": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatIn"
      },
      "EvalIn": {
        "properties": {
          "questions_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Questions Path"
          },
          "inline": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inline"
          },
          "chunk_tokens": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array",
                "maxItems": 6
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Tokens"
          },
          "top_k": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array",
                "maxItems": 6
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          },
          "mmr": {
            "type": "boolean",
            "title": "Mmr",
            "default": true
          },
          "rerank": {
            "type": "boolean",
            "title": "Rerank",
            "default": false
          },
          "judge": {
            "type": "boolean",
            "title": "Judge",
            "default": false
          }
        },
        "type": "object",
        "title": "EvalIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestIn": {
        "properties": {
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paths"
          }
        },
        "type": "object",
        "title": "IngestIn"
      },
      "Options": {
        "properties": {
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          },
          "mmr": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mmr"
          },
          "rerank": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rerank"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          }
        },
        "type": "object",
        "title": "Options"
      },
      "RetrieveIn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrieveIn"
      },
      "Scope": {
        "properties": {
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files",
            "default": []
          },
          "folders": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Folders",
            "default": []
          }
        },
        "type": "object",
        "title": "Scope"
      },
      "SessionIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60,
            "title": "Title",
            "default": "New chat"
          }
        },
        "type": "object",
        "title": "SessionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}